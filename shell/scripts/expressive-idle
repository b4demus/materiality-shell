#!/usr/bin/env python3
"""expressive-idle — idle timeouts (blank / lock / suspend) for the shell.

Quickshell 0.2 exposes no idle-notify binding and niri has no idle section, so
the timers are delegated to `swayidle`, which speaks ext-idle-notify to niri.
One owned process, tracked by a pidfile, rebuilt whenever the settings change.

Usage:
  expressive-idle status              JSON: backend availability + state
  expressive-idle apply '<json>'      restart swayidle to match the config
  expressive-idle off                 stop it

Config JSON keys (seconds; 0 disables that stage):
  screenTimeoutSec, lockTimeoutSec, suspendTimeoutSec, dimBeforeSleep
"""
from __future__ import annotations

import json
import os
import shutil
import signal
import subprocess
import sys
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "expressive"
PIDFILE = STATE / "idle.pid"
CFGFILE = STATE / "idle.json"

LOCK_CMD = "qs -c expressive ipc call lock lock"
BLANK_OFF = "niri msg action power-off-monitors"
BLANK_ON = "niri msg action power-on-monitors"


def available() -> bool:
    return shutil.which("swayidle") is not None


def running_pid() -> int | None:
    try:
        pid = int(PIDFILE.read_text().strip())
        os.kill(pid, 0)
        if Path(f"/proc/{pid}/comm").read_text().strip() != "swayidle":
            return None
        return pid
    except (OSError, ValueError):
        return None


def stop() -> None:
    pid = running_pid()
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    PIDFILE.unlink(missing_ok=True)


def apply(cfg: dict) -> int:
    STATE.mkdir(parents=True, exist_ok=True)
    CFGFILE.write_text(json.dumps(cfg, indent=2))
    stop()

    if not available():
        print("swayidle is not installed", file=sys.stderr)
        return 3

    lock = int(cfg.get("lockTimeoutSec", 0) or 0)
    blank = int(cfg.get("screenTimeoutSec", 0) or 0)
    sleep = int(cfg.get("suspendTimeoutSec", 0) or 0)

    args = ["swayidle", "-w"]
    # Ordered shortest-first; swayidle fires each stage as it is reached.
    for secs, cmd in sorted(
        [(lock, LOCK_CMD), (blank, BLANK_OFF), (sleep, "systemctl suspend")],
        key=lambda p: p[0],
    ):
        if secs > 0:
            args += ["timeout", str(secs), cmd]
            if cmd == BLANK_OFF:
                args += ["resume", BLANK_ON]
    # Always lock before the machine actually sleeps.
    if lock > 0 or sleep > 0:
        args += ["before-sleep", LOCK_CMD]

    if len(args) <= 2:
        return 0

    proc = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            start_new_session=True)
    PIDFILE.write_text(str(proc.pid))
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] == "status":
        cfg = {}
        try:
            cfg = json.loads(CFGFILE.read_text())
        except (OSError, json.JSONDecodeError):
            pass
        print(json.dumps({
            "available": available(),
            "backend": "swayidle" if available() else "",
            "running": running_pid() is not None,
            "config": cfg,
            "installHint": "sudo dnf install swayidle",
        }, indent=2))
        return 0
    if argv[0] == "off":
        stop()
        return 0
    if argv[0] == "apply":
        return apply(json.loads(argv[1]) if len(argv) > 1 else {})
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
