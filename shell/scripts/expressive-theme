#!/usr/bin/env python3
"""expressive-theme  —  palette engine for the "expressive" Quickshell shell.

From the active palette it writes, in one shot:
  * ~/.local/state/expressive/colors.json  (config/Colors.qml watches this)
  * niri focus-ring colours                (block in ~/.config/niri/config.kdl)
  * ~/.config/alacritty/theme.toml + a managed block in alacritty.toml
    (colours + JetBrains Mono; Alacritty live-reloads)
  * managed blocks in ~/.config/gtk-3.0/gtk.css and gtk-4.0/gtk.css
    (@define-color for libadwaita + classic GTK names; running apps need a
    restart) and `gsettings ... color-scheme prefer-dark`.

Modes (argument, or the persisted value in ~/.local/state/expressive/scheme):
  dynamic         Material You generated live from the wallpaper by matugen
                  (the original behaviour — unchanged).
  auto            the curated scheme (Gruvbox … Everforest) whose palette is
                  closest to the current wallpaper's dominant colours.
  accent:#rrggbb  a Material You palette generated from a hand-picked accent
                  colour (used when "dynamic colours" is switched off).
  <scheme-name>   force a curated scheme from theme/schemes/<name>.json.

Usage:
  expressive-theme                 apply the persisted mode
  expressive-theme <mode>          apply <mode> and persist it
  expressive-theme --match [img]   print the best-matching curated scheme, no write
  expressive-theme --list          print "name<TAB>label" for every curated scheme
"""
from __future__ import annotations

import json
import math
import os
import re
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "expressive"
CONF_DIR = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "quickshell/expressive"
SCHEMES_DIR = CONF_DIR / "theme" / "schemes"
COLORS_JSON = STATE_DIR / "colors.json"
WALL_FILE = STATE_DIR / "wallpaper"
SCHEME_FILE = STATE_DIR / "scheme"
MATUGEN_CONF = CONF_DIR / "theme" / "matugen.toml"
_CFG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
NIRI_CONF = _CFG / "niri" / "config.kdl"
ALACRITTY_DIR = _CFG / "alacritty"
ALACRITTY_MAIN = ALACRITTY_DIR / "alacritty.toml"
ALACRITTY_THEME = ALACRITTY_DIR / "theme.toml"
GTK_CSS = [_CFG / "gtk-3.0" / "gtk.css", _CFG / "gtk-4.0" / "gtk.css"]
GTK3_SETTINGS = _CFG / "gtk-3.0" / "settings.ini"
GTK4_SETTINGS = _CFG / "gtk-4.0" / "settings.ini"
QTCT_DIRS = [_CFG / "qt5ct", _CFG / "qt6ct"]
SETTINGS_JSON = STATE_DIR / "settings.json"
LOG = STATE_DIR / "theme.log"

MONO_FONT = "JetBrains Mono"
BLK_OPEN = "/* >>> expressive (managed — regenerated by expressive-theme) >>> */"
BLK_CLOSE = "/* <<< expressive <<< */"
TOML_OPEN = "# >>> expressive (managed — regenerated by expressive-theme) >>>"
TOML_CLOSE = "# <<< expressive <<<"

# M3 role keys the shell's template expects (config/Colors.qml -> v(key)).
ROLE_KEYS = [
    "background", "onBackground", "surface", "surfaceDim", "surfaceBright",
    "surfaceContainerLowest", "surfaceContainerLow", "surfaceContainer",
    "surfaceContainerHigh", "surfaceContainerHighest", "surfaceVariant",
    "onSurface", "onSurfaceVariant", "outline", "outlineVariant",
    "primary", "onPrimary", "primaryContainer", "onPrimaryContainer",
    "secondary", "onSecondary", "secondaryContainer", "onSecondaryContainer",
    "tertiary", "onTertiary", "tertiaryContainer", "onTertiaryContainer",
    "error", "onError", "errorContainer", "onErrorContainer",
    "shadow", "scrim", "inverseSurface", "inverseOnSurface", "inversePrimary",
]


def log(msg: str) -> None:
    print(msg)
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        with LOG.open("a") as fh:
            fh.write(msg + "\n")
    except OSError:
        pass


# --------------------------------------------------------------------------- #
#  colour maths  (sRGB 8-bit hex  <->  linear  <->  OKLab)
# --------------------------------------------------------------------------- #
def hex2rgb(h: str) -> tuple[float, float, float]:
    h = h.lstrip("#")
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    return tuple(int(h[i:i + 2], 16) / 255.0 for i in (0, 2, 4))  # type: ignore


def rgb2hex(rgb) -> str:
    return "#" + "".join(f"{max(0, min(255, round(c * 255))):02x}" for c in rgb)


def _s2l(c: float) -> float:
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def _l2s(c: float) -> float:
    c = max(0.0, min(1.0, c))
    return c * 12.92 if c <= 0.0031308 else 1.055 * (c ** (1 / 2.4)) - 0.055


def to_lin(rgb):
    return tuple(_s2l(c) for c in rgb)


def to_srgb(lin):
    return tuple(_l2s(c) for c in lin)


def luminance(rgb) -> float:
    r, g, b = to_lin(rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b) -> float:
    la, lb = luminance(a), luminance(b)
    hi, lo = max(la, lb), min(la, lb)
    return (hi + 0.05) / (lo + 0.05)


def mix(a, b, t: float):
    """Blend in gamma (sRGB) space — matches how base16 palettes are authored and
    keeps the dark surface ladder in small, predictable steps. t=0 -> a, t=1 -> b."""
    return tuple(x + (y - x) * t for x, y in zip(a, b))


WHITE = (1.0, 1.0, 1.0)
BLACK = (0.0, 0.0, 0.0)

# How far the terminal's base text colour is pulled toward the scheme accent
# (primary). 0 = neutral onSurface, 1 = pure accent. Kept low for readability.
FG_TINT = 0.20

# The darkest dark-mode background (`background` / `surface` — the top bar and
# terminal). Capped in luminance (lower = darker) AND in OKLab chroma, so a
# vivid/red wallpaper yields a near-black with only a whisper of the hue rather
# than a "bloody" saturated dark. The whole dark ladder is `mix(bg, fg, …)`.
DARK_BG_LUM = 0.006
DARK_BG_CHROMA = 0.014


def _to_lum(rgb, target: float, anchor):
    """Blend rgb toward anchor (white or black) until luminance ~= target."""
    lo, hi = 0.0, 1.0
    for _ in range(24):
        mid = (lo + hi) / 2
        if luminance(mix(rgb, anchor, mid)) > target:
            if anchor is WHITE:
                hi = mid
            else:
                lo = mid
        else:
            if anchor is WHITE:
                lo = mid
            else:
                hi = mid
    return mix(rgb, anchor, (lo + hi) / 2)


def lighten_to(rgb, target: float):
    return rgb if luminance(rgb) >= target else _to_lum(rgb, target, WHITE)


def darken_to(rgb, target: float):
    return rgb if luminance(rgb) <= target else _to_lum(rgb, target, BLACK)


def clamp_lum(rgb, lo: float, hi: float):
    lum = luminance(rgb)
    if lum < lo:
        return lighten_to(rgb, lo)
    if lum > hi:
        return darken_to(rgb, hi)
    return rgb


def on_color(bg, fg_hint):
    """Readable foreground for bg: a strongly toned fg_hint, else black/white."""
    dark_on = darken_to(fg_hint, 0.045)
    light_on = lighten_to(fg_hint, 0.93)
    cand = light_on if luminance(bg) < 0.42 else dark_on
    if contrast(cand, bg) >= 4.5:
        return cand
    return WHITE if contrast(WHITE, bg) >= contrast(BLACK, bg) else BLACK


# sRGB -> OKLab  (Björn Ottosson)
def oklab(rgb):
    r, g, b = to_lin(rgb)
    l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b
    m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b
    s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b
    l, m, s = l ** (1 / 3), m ** (1 / 3), s ** (1 / 3)
    return (
        0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
        1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
        0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s,
    )


def dE(a, b) -> float:
    la, lb = oklab(a), oklab(b)
    return sum((x - y) ** 2 for x, y in zip(la, lb)) ** 0.5


def oklab_to_srgb(L, a, b):
    l_ = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m_ = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s_ = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    r = 4.0767416621 * l_ - 3.3077115913 * m_ + 0.2309699292 * s_
    g = -1.2684380046 * l_ + 2.6097574011 * m_ - 0.3413193965 * s_
    bb = -0.0041960863 * l_ - 0.7034186147 * m_ + 1.7076147010 * s_
    return to_srgb((r, g, bb))


def saturate(rgb, factor: float):
    """Scale OKLab chroma. factor>1 punches a muted colour up without shifting hue."""
    L, a, b = oklab(rgb)
    return oklab_to_srgb(L, a * factor, b * factor)


def boost_chroma(rgb, cmin: float):
    """Raise OKLab chroma to at least cmin, keeping hue and lightness."""
    L, a, b = oklab(rgb)
    c = (a * a + b * b) ** 0.5
    if c >= cmin or c < 1e-4:
        return rgb
    k = cmin / c
    return oklab_to_srgb(L, a * k, b * k)


def cap_chroma(rgb, cmax: float):
    """Lower OKLab chroma to at most cmax, keeping hue and lightness."""
    L, a, b = oklab(rgb)
    c = (a * a + b * b) ** 0.5
    if c <= cmax or c < 1e-4:
        return rgb
    k = cmax / c
    return oklab_to_srgb(L, a * k, b * k)


# --------------------------------------------------------------------------- #
#  curated scheme  ->  full M3 role map
# --------------------------------------------------------------------------- #
def expand_variant(v: dict, dark: bool) -> dict:
    bg = hex2rgb(v["bg"])
    fg = hex2rgb(v["fg"])
    out: dict[str, str] = {}

    if dark:
        # Deliberately dark: the ladder barely lifts off `bg` so the whole shell
        # stays "dark execution" (Everforest-dark rather than washed grey).
        bg = cap_chroma(darken_to(bg, DARK_BG_LUM), DARK_BG_CHROMA)
        surfaces = {
            "background": bg,
            "surface": bg,
            "surfaceDim": darken_to(bg, max(0.0, luminance(bg) * 0.7)),
            "surfaceBright": mix(bg, fg, 0.14),
            "surfaceContainerLowest": darken_to(bg, max(0.0, luminance(bg) * 0.5)),
            "surfaceContainerLow": mix(bg, fg, 0.028),
            "surfaceContainer": mix(bg, fg, 0.05),
            "surfaceContainerHigh": mix(bg, fg, 0.078),
            "surfaceContainerHighest": mix(bg, fg, 0.11),
            "surfaceVariant": mix(bg, fg, 0.17),
        }
    else:
        surfaces = {
            "background": bg,
            "surface": bg,
            "surfaceDim": mix(bg, fg, 0.12),
            "surfaceBright": lighten_to(bg, min(1.0, luminance(bg) + 0.05)),
            "surfaceContainerLowest": lighten_to(bg, min(1.0, luminance(bg) + 0.06)),
            "surfaceContainerLow": mix(bg, fg, 0.03),
            "surfaceContainer": mix(bg, fg, 0.055),
            "surfaceContainerHigh": mix(bg, fg, 0.085),
            "surfaceContainerHighest": mix(bg, fg, 0.12),
            "surfaceVariant": mix(bg, fg, 0.16),
        }
    for k, c in surfaces.items():
        out[k] = rgb2hex(c)

    out["onBackground"] = rgb2hex(fg)
    out["onSurface"] = rgb2hex(fg)
    out["onSurfaceVariant"] = rgb2hex(mix(fg, bg, 0.30))
    out["outline"] = rgb2hex(mix(fg, bg, 0.52))
    out["outlineVariant"] = rgb2hex(mix(fg, bg, 0.78))

    for role in ("primary", "secondary", "tertiary", "error"):
        acc = hex2rgb(v[role])
        cap = role.capitalize()
        if dark:
            main = clamp_lum(acc, 0.36, 0.84)
            container = mix(darken_to(acc, 0.14), bg, 0.34)
            on_container = lighten_to(acc, 0.85)
        else:
            main = clamp_lum(acc, 0.18, 0.46)
            container = mix(lighten_to(acc, 0.86), bg, 0.20)
            on_container = darken_to(acc, 0.16)
        out[role] = rgb2hex(main)
        out["on" + cap] = rgb2hex(on_color(main, fg if luminance(main) < 0.5 else bg))
        out[role + "Container"] = rgb2hex(container)
        out["on" + cap + "Container"] = rgb2hex(on_container)

    out["shadow"] = "#000000"
    out["scrim"] = "#000000"
    if dark:
        out["inverseSurface"] = rgb2hex(mix(fg, bg, 0.06))
        out["inverseOnSurface"] = rgb2hex(mix(bg, fg, 0.06))
        out["inversePrimary"] = rgb2hex(darken_to(hex2rgb(v["primary"]), 0.38))
    else:
        out["inverseSurface"] = rgb2hex(mix(fg, bg, 0.10))
        out["inverseOnSurface"] = rgb2hex(mix(bg, fg, 0.04))
        out["inversePrimary"] = rgb2hex(lighten_to(hex2rgb(v["primary"]), 0.72))

    return {k: out[k] for k in ROLE_KEYS}


def load_scheme(name: str) -> dict:
    path = SCHEMES_DIR / f"{name}.json"
    if not path.is_file():
        raise SystemExit(f"expressive-theme: no such scheme: {name} ({path})")
    data = json.loads(path.read_text())
    dark_src = data["dark"]
    light_src = data.get("light") or {
        "bg": data["dark"]["fg"], "fg": data["dark"]["bg"],
        "primary": data["dark"]["primary"], "secondary": data["dark"]["secondary"],
        "tertiary": data["dark"]["tertiary"], "error": data["dark"]["error"],
    }
    return {
        "dark": expand_variant(dark_src, dark=True),
        "light": expand_variant(light_src, dark=False),
    }


def all_schemes() -> list[dict]:
    out = []
    if SCHEMES_DIR.is_dir():
        for p in sorted(SCHEMES_DIR.glob("*.json")):
            try:
                out.append(json.loads(p.read_text()))
            except (OSError, json.JSONDecodeError):
                pass
    return out


# --------------------------------------------------------------------------- #
#  wallpaper  ->  nearest curated scheme
# --------------------------------------------------------------------------- #
def wallpaper_palette(img_path: str, k: int = 8):
    """[(rgb, weight)] dominant colours of the image, weights sum to 1."""
    from PIL import Image

    im = Image.open(img_path).convert("RGB")
    im.thumbnail((200, 200))
    q = im.quantize(colors=k, method=Image.Quantize.MEDIANCUT)
    pal = q.getpalette()
    counts = sorted(q.getcolors(), key=lambda c: -c[0])
    total = sum(c for c, _ in counts) or 1
    out = []
    for cnt, idx in counts:
        rgb = tuple(pal[idx * 3 + j] / 255.0 for j in range(3))
        out.append((rgb, cnt / total))
    return out


def match_scheme(img_path: str) -> str:
    pal = wallpaper_palette(img_path)
    img_lum = sum(luminance(c) * w for c, w in pal)
    best, best_score = None, 1e9
    for sch in all_schemes():
        v = sch["dark"]
        pool = [hex2rgb(v["bg"]), hex2rgb(v["fg"])] + [hex2rgb(x) for x in v["accents"]]
        acc_cost = sum(w * min(dE(c, p) for p in pool) for c, w in pal)
        bg_cost = abs(img_lum - luminance(hex2rgb(v["bg"]))) * 0.9
        score = acc_cost + bg_cost
        if score < best_score:
            best, best_score = sch["name"], score
    return best or "gruvbox"


# --------------------------------------------------------------------------- #
#  niri focus ring  <-  active palette
# --------------------------------------------------------------------------- #
def patch_niri(colors: dict) -> None:
    if not NIRI_CONF.is_file():
        return
    text = NIRI_CONF.read_text()
    if "expressive:colors" not in text:
        return
    d = colors["dark" if current_dark() else "light"]
    repl = {
        "active-color": d["primary"],
        "inactive-color": d["outlineVariant"],
        "urgent-color": d["error"],
    }

    def patch(block: str) -> str:
        for key, val in repl.items():
            block = re.sub(rf'(\b{key}\s+)"[^"]*"', rf'\g<1>"{val}"', block)
        return block

    new = re.sub(r"=== expressive:colors.*?=== /expressive:colors ===",
                 lambda m: patch(m.group(0)), text, flags=re.S)
    if new != text:
        NIRI_CONF.write_text(new)
        log("recoloured niri focus ring")


def write_colors(colors: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = COLORS_JSON.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(colors, indent=4) + "\n")
    os.replace(tmp, COLORS_JSON)


def _matugen_bin() -> str:
    from shutil import which
    return which("matugen") or str(HOME / ".local/bin/matugen")


def dominant_seed(img_path: str):
    """The wallpaper's defining colour: the cluster with the most weight*chroma.
    Falls back to the most dominant cluster if the image is basically greyscale."""
    pal = wallpaper_palette(img_path, k=12)
    def chroma(rgb):
        _, a, b = oklab(rgb)
        return (a * a + b * b) ** 0.5
    ranked = sorted(pal, key=lambda p: -(p[1] * chroma(p[0])))
    top = ranked[0][0]
    return top if chroma(top) > 0.012 else max(pal, key=lambda p: p[1])[0]


def anchors_from_seed(seed_hex: str) -> dict:
    """Anchor set from one seed colour: a dark tint of the seed for the surfaces,
    with primary/secondary/tertiary from matugen's *content* scheme (faithful to
    the seed hue — no Material-You hue rotation)."""
    seed = hex2rgb(seed_hex)
    anchors = {
        "bg": rgb2hex(darken_to(seed, 0.018)),          # very dark, keeps the hue
        "fg": rgb2hex(lighten_to(mix(seed, (0.85, 0.85, 0.85), 0.7), 0.86)),
        "primary": rgb2hex(clamp_lum(seed, 0.55, 0.82)),
        "secondary": rgb2hex(clamp_lum(mix(seed, (0.6, 0.6, 0.6), 0.35), 0.55, 0.8)),
        "tertiary": rgb2hex(clamp_lum(seed, 0.6, 0.82)),
        "error": "#ff6b6b",
    }
    try:
        out = subprocess.run(
            [_matugen_bin(), "color", "hex", seed_hex, "--type", "scheme-content",
             "-j", "hex"],
            check=True, capture_output=True, text=True,
        )
        c = json.loads(out.stdout)["colors"]
        anchors["fg"] = c["on_surface"]["dark"]["color"]
        # matugen's content accents track the seed hue but can come out near-grey on
        # a desaturated wallpaper — lift them to a floor chroma so they read as colour
        anchors["primary"] = rgb2hex(boost_chroma(hex2rgb(c["primary"]["dark"]["color"]), 0.070))
        anchors["secondary"] = rgb2hex(boost_chroma(hex2rgb(c["secondary"]["dark"]["color"]), 0.045))
        anchors["tertiary"] = rgb2hex(boost_chroma(hex2rgb(c["tertiary"]["dark"]["color"]), 0.060))
        anchors["error"] = c["error"]["dark"]["color"]
        log(f"dynamic: seed {seed_hex} -> primary {anchors['primary']} (matugen scheme-content)")
    except (FileNotFoundError, subprocess.CalledProcessError, KeyError, json.JSONDecodeError) as e:
        log(f"dynamic: seed {seed_hex}, matugen unavailable ({type(e).__name__}) — pure-seed palette")
    return anchors


def dynamic_anchors(img_path: str) -> dict:
    """`dynamic` mode: seed the palette with the wallpaper's defining colour."""
    return anchors_from_seed(rgb2hex(dominant_seed(img_path)))


def variants_from_anchors(a: dict) -> dict:
    """Expand one dark anchor set into the full dark + light role maps."""
    seed = hex2rgb(a["primary"])
    light = {
        "bg": rgb2hex(lighten_to(mix(seed, (1.0, 1.0, 1.0), 0.7), 0.94)),
        "fg": rgb2hex(darken_to(mix(seed, (0.2, 0.2, 0.2), 0.5), 0.06)),
        "primary": rgb2hex(clamp_lum(seed, 0.18, 0.44)),
        "secondary": rgb2hex(clamp_lum(hex2rgb(a["secondary"]), 0.2, 0.46)),
        "tertiary": rgb2hex(clamp_lum(hex2rgb(a["tertiary"]), 0.2, 0.46)),
        "error": "#ba1a1a",
    }
    return {
        "dark": expand_variant(a, dark=True),
        "light": expand_variant(light, dark=False),
    }


def dynamic_variants(img_path: str) -> dict:
    return variants_from_anchors(dynamic_anchors(img_path))


def accent_variants(seed_hex: str) -> dict:
    """`accent:#rrggbb` mode: a full Material You palette from a colour the user
    picked by hand, ignoring the wallpaper entirely."""
    return variants_from_anchors(anchors_from_seed(seed_hex))


# --------------------------------------------------------------------------- #
#  Alacritty  +  GTK  <-  active palette
# --------------------------------------------------------------------------- #
def scheme_accents(name: str):
    try:
        return json.loads((SCHEMES_DIR / f"{name}.json").read_text())["dark"].get("accents")
    except (OSError, json.JSONDecodeError, KeyError):
        return None


def _lift(hex_c: str, amt: float = 0.16) -> str:
    return rgb2hex(mix(hex2rgb(hex_c), WHITE, amt))


# Canonical ANSI hues as OKLab hue angles (deg) + a readable lightness per ground.
_ANSI_HUE = {"red": 27, "green": 142, "yellow": 95, "blue": 259, "magenta": 328, "cyan": 196}
_ANSI_L   = {"red": 0.66, "green": 0.75, "yellow": 0.80, "blue": 0.64, "magenta": 0.68, "cyan": 0.74}
_ANSI_L_LIGHT = {"red": 0.52, "green": 0.50, "yellow": 0.56, "blue": 0.50,
                 "magenta": 0.52, "cyan": 0.48}


def _oklch(hue_deg: float, L: float, C: float):
    h = math.radians(hue_deg)
    return oklab_to_srgb(L, C * math.cos(h), C * math.sin(h))


def synth_ansi_hues(d: dict, dark: bool = True) -> list[str]:
    """Six ANSI hues rendered at the *scheme's own* chroma and tone, so the
    terminal palette reads as part of the Material You scheme (used for `dynamic`,
    where there is no curated `accents[]`)."""
    chs = []
    for k in ("primary", "secondary", "tertiary"):
        _, a, b = oklab(hex2rgb(d[k]))
        chs.append((a * a + b * b) ** 0.5)
    scheme_c = sum(chs) / len(chs)
    C = max(0.085, min(0.155, scheme_c * 1.15 + 0.02))
    tones = _ANSI_L if dark else _ANSI_L_LIGHT
    out = []
    for name in ("red", "green", "yellow", "blue", "magenta", "cyan"):
        cc = C * (0.78 if name == "yellow" else 1.0)   # yellow leaves gamut at high C
        out.append(rgb2hex(_oklch(_ANSI_HUE[name], tones[name], cc)))
    return out


def ansi_palette(colors: dict, scheme_name: str | None, dark: bool = True) -> dict:
    """16 terminal colours derived from the active M3 palette, for either ground."""
    d = colors["dark" if dark else "light"]
    p = hex2rgb(d["primary"])
    acc = scheme_accents(scheme_name) if scheme_name else None
    if acc and len(acc) >= 6:
        hues = list(acc[:6])                       # red green yellow blue magenta cyan
        if not dark:                               # curated accents are tuned for a dark bg
            hues = [rgb2hex(darken_to(hex2rgb(h), 0.34)) for h in hues]
    else:
        hues = synth_ansi_hues(d, dark)

    emph = _lift if dark else (lambda c: rgb2hex(mix(hex2rgb(c), (0.0, 0.0, 0.0), 0.16)))
    tw = lambda role: rgb2hex(mix(hex2rgb(d[role]), p, FG_TINT * 0.7))

    # "black" is the ground-ward neutral, "white" the text-ward one — which M3
    # role each maps to flips with the ground.
    if dark:
        black_lo, black_hi = d["surfaceContainerHighest"], d["outline"]
        white_lo, white_hi = "onSurfaceVariant", "onSurface"
    else:
        black_lo, black_hi = d["onSurfaceVariant"], d["onSurface"]
        white_lo, white_hi = "surfaceContainerHigh", "surfaceBright"

    normal = {
        "black": black_lo,
        "red": hues[0], "green": hues[1], "yellow": hues[2],
        "blue": hues[3], "magenta": hues[4], "cyan": hues[5],
        "white": tw(white_lo),
    }
    bright = {
        "black": black_hi,
        "red": emph(hues[0]), "green": emph(hues[1]), "yellow": emph(hues[2]),
        "blue": emph(hues[3]), "magenta": emph(hues[4]), "cyan": emph(hues[5]),
        "white": tw(white_hi),
    }
    return {"normal": normal, "bright": bright}


def _managed_block(path: Path, body: str, open_m: str, close_m: str,
                   comment_prefix: str = "") -> None:
    """Insert/replace an `open_m … close_m` block; keep everything else intact."""
    block = f"{open_m}\n{body.rstrip()}\n{close_m}\n"
    try:
        old = path.read_text() if path.exists() else ""
    except OSError:
        old = ""
    if open_m in old and close_m in old:
        new = re.sub(re.escape(open_m) + r".*?" + re.escape(close_m) + r"\n?",
                     block, old, flags=re.S)
    else:
        sep = "" if (old == "" or old.endswith("\n")) else "\n"
        new = old + sep + ("\n" if old.strip() else "") + block
    if new != old:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(path.suffix + ".tmp")
        tmp.write_text(new)
        os.replace(tmp, path)


def write_alacritty(colors: dict, scheme_name: str | None, dark: bool = True) -> None:
    d = colors["dark" if dark else "light"]
    a = ansi_palette(colors, scheme_name, dark)
    q = lambda c: f'"{c}"'

    # Base text tinted toward the scheme accent so the terminal reads as part of
    # the active palette rather than a neutral near-white.
    accent = hex2rgb(d["primary"])
    fg = rgb2hex(mix(hex2rgb(d["onSurface"]), accent, FG_TINT))
    dim_fg = rgb2hex(mix(hex2rgb(d["onSurfaceVariant"]), accent, FG_TINT * 0.8))

    lines = [
        "# generated by expressive-theme — do not edit; imported from alacritty.toml",
        "",
        "[colors.primary]",
        f"background = {q(d['background'])}",
        f"foreground = {q(fg)}",
        f"dim_foreground = {q(dim_fg)}",
        "",
        "[colors.cursor]",
        f"text = {q(d['background'])}",
        f"cursor = {q(d['primary'])}",
        "",
        "[colors.vi_mode_cursor]",
        f"text = {q(d['background'])}",
        f"cursor = {q(d['secondary'])}",
        "",
        "[colors.selection]",
        'text = "CellForeground"',
        f"background = {q(d['primaryContainer'])}",
        "",
        "[colors.normal]",
        *[f"{k} = {q(v)}" for k, v in a["normal"].items()],
        "",
        "[colors.bright]",
        *[f"{k} = {q(v)}" for k, v in a["bright"].items()],
        "",
    ]
    ALACRITTY_THEME.parent.mkdir(parents=True, exist_ok=True)
    tmp = ALACRITTY_THEME.with_suffix(".toml.tmp")
    tmp.write_text("\n".join(lines))
    os.replace(tmp, ALACRITTY_THEME)

    # ensure alacritty.toml imports the theme and uses the mono font
    body = "\n".join([
        "[general]",
        f'import = ["{ALACRITTY_THEME}"]',
        "live_config_reload = true",
        "",
        "[font]",
        "size = 11.0",
        "",
        "[font.normal]",
        f'family = "{MONO_FONT}"',
        'style = "Regular"',
    ])
    existing = ALACRITTY_MAIN.read_text() if ALACRITTY_MAIN.exists() else ""
    outside = re.sub(re.escape(TOML_OPEN) + r".*?" + re.escape(TOML_CLOSE), "",
                     existing, flags=re.S)
    for tbl in ("[general]", "[font]", "[font.normal]"):
        if re.search(r"(?m)^\s*" + re.escape(tbl), outside):
            log(f"alacritty.toml already defines {tbl} outside the managed block — "
                f"left it; check for a duplicate-table error")
    _managed_block(ALACRITTY_MAIN, body, TOML_OPEN, TOML_CLOSE)


def _ini_set(path: Path, section: str, kv: dict) -> None:
    """Set keys in a section of a simple INI file, keeping everything else."""
    try:
        old = path.read_text() if path.exists() else ""
    except OSError:
        old = ""
    lines = old.splitlines()
    out, in_sec, seen, done = [], False, set(), False
    for ln in lines:
        st = ln.strip()
        if st.startswith("[") and st.endswith("]"):
            if in_sec:                      # leaving our section — flush missing keys
                for k, v in kv.items():
                    if k not in seen:
                        out.append(f"{k}={v}")
                done = True
            in_sec = (st == f"[{section}]")
            out.append(ln)
            continue
        if in_sec and "=" in st and not st.startswith("#"):
            k = st.split("=", 1)[0].strip()
            if k in kv:
                out.append(f"{k}={kv[k]}")
                seen.add(k)
                continue
        out.append(ln)
    if in_sec and not done:
        for k, v in kv.items():
            if k not in seen:
                out.append(f"{k}={v}")
    elif not in_sec and not done:
        if out and out[-1].strip():
            out.append("")
        out.append(f"[{section}]")
        for k, v in kv.items():
            out.append(f"{k}={v}")
    new = "\n".join(out).rstrip() + "\n"
    if new != old:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(path.suffix + ".tmp")
        tmp.write_text(new)
        os.replace(tmp, path)


def write_qt(colors: dict, dark: bool) -> None:
    """A qt5ct / qt6ct colour scheme + config, so Qt apps carry the same palette
    as GTK. The live path is QT_QPA_PLATFORMTHEME=gtk3 (set in the niri env),
    which reads the GTK colours directly; these files make the qt*ct platform
    themes match too, for anyone who picks them instead."""
    d = colors["dark" if dark else "light"]
    def c(k):
        return "#ff" + d[k].lstrip("#")
    # QPalette role order used by qt5ct/qt6ct colour-scheme files.
    roles = [
        c("onSurface"),            # WindowText
        c("surfaceContainerHigh"), # Button
        c("surfaceBright"),        # Light
        c("surfaceContainerHigh"), # Midlight
        c("outline"),              # Dark
        c("outlineVariant"),       # Mid
        c("onSurface"),            # Text
        c("error"),                # BrightText
        c("onSurface"),            # ButtonText
        c("surface"),              # Base
        c("background"),           # Window
        c("shadow"),               # Shadow
        c("primary"),              # Highlight
        c("onPrimary"),            # HighlightedText
        c("primary"),              # Link
        c("tertiary"),             # LinkVisited
        c("surfaceContainer"),     # AlternateBase
        c("background"),           # NoRole
        c("surfaceContainerHighest"),  # ToolTipBase
        c("onSurface"),            # ToolTipText
        c("onSurfaceVariant"),     # PlaceholderText
    ]
    dim = "#ff" + mix_hex(d["onSurfaceVariant"], d["surface"], 0.5).lstrip("#")
    disabled = list(roles)
    for i in (0, 6, 8, 19):        # WindowText, Text, ButtonText, ToolTipText
        disabled[i] = dim
    disabled[13] = dim            # HighlightedText

    scheme = "\n".join([
        "[ColorScheme]",
        "active_colors=" + ", ".join(roles),
        "disabled_colors=" + ", ".join(disabled),
        "inactive_colors=" + ", ".join(roles),
        "",
    ])
    for base in QTCT_DIRS:
        cf = base / "colors" / "expressive.conf"
        cf.parent.mkdir(parents=True, exist_ok=True)
        cf.write_text(scheme)
        _ini_set(base / (base.name + ".conf"), "Appearance", {
            "custom_palette": "true",
            "color_scheme_path": str(cf),
            "style": "Fusion",
        })


def mix_hex(a: str, b: str, t: float) -> str:
    return rgb2hex(mix(hex2rgb(a), hex2rgb(b), t))


def _rgb255(hex_c: str) -> str:
    r, g, b = (max(0, min(255, round(x * 255))) for x in hex2rgb(hex_c))
    return f"{r},{g},{b}"


def write_kde(colors: dict, dark: bool) -> None:
    """KDE / KF6 apps (KWrite, Kate, Dolphin, …) colour themselves from
    `kdeglobals` [Colors:*], not from the Qt platform theme. Generate one from
    the active M3 palette (+ a matching .colors file), and pin the widget style
    to Fusion since Breeze isn't installed here."""
    d = colors["dark" if dark else "light"]
    R = _rgb255

    def section(bg, bg_alt):
        return {
            "BackgroundNormal": R(d[bg]),
            "BackgroundAlternate": R(d[bg_alt]),
            "ForegroundNormal": R(d["onSurface"]),
            "ForegroundInactive": R(d["onSurfaceVariant"]),
            "ForegroundActive": R(d["primary"]),
            "ForegroundLink": R(d["primary"]),
            "ForegroundVisited": R(d["tertiary"]),
            "ForegroundNegative": R(d["error"]),
            "ForegroundNeutral": R(d["secondary"]),
            "ForegroundPositive": R(d["tertiary"]),
            "DecorationFocus": R(d["primary"]),
            "DecorationHover": R(d["primary"]),
        }

    groups = {
        "Colors:Window": section("background", "surfaceContainer"),
        "Colors:View": section("surface", "surfaceContainerLow"),
        "Colors:Button": section("surfaceContainerHigh", "surfaceContainerHighest"),
        "Colors:Tooltip": section("surfaceContainerHighest", "surfaceContainerHigh"),
        "Colors:Complementary": section("surfaceDim", "surfaceContainerLowest"),
        "Colors:Header": section("surfaceContainer", "surfaceContainerHigh"),
        "Colors:Selection": {
            "BackgroundNormal": R(d["primary"]),
            "BackgroundAlternate": R(d["primary"]),
            "ForegroundNormal": R(d["onPrimary"]),
            "ForegroundInactive": R(d["onPrimary"]),
            "ForegroundActive": R(d["onPrimary"]),
            "ForegroundLink": R(d["onPrimary"]),
            "ForegroundVisited": R(d["onPrimary"]),
            "ForegroundNegative": R(d["onError"]),
            "ForegroundNeutral": R(d["onPrimary"]),
            "ForegroundPositive": R(d["onPrimary"]),
            "DecorationFocus": R(d["primary"]),
            "DecorationHover": R(d["primary"]),
        },
    }
    wm = {
        "activeBackground": R(d["surfaceContainer"]),
        "activeForeground": R(d["onSurface"]),
        "inactiveBackground": R(d["background"]),
        "inactiveForeground": R(d["onSurfaceVariant"]),
        "activeBlend": R(d["primary"]),
        "inactiveBlend": R(d["outlineVariant"]),
    }

    kde_conf = _CFG / "kdeglobals"
    for grp, kv in groups.items():
        _ini_set(kde_conf, grp, kv)
    _ini_set(kde_conf, "WM", wm)
    _ini_set(kde_conf, "General", {
        "ColorScheme": "Expressive",
        "Name": "Expressive",
        "shadeSortColumn": "true",
    })
    _ini_set(kde_conf, "KDE", {"widgetStyle": "Fusion"})

    # a stand-alone scheme file so the Colours KCM lists it too
    cs = HOME / ".local/share/color-schemes/Expressive.colors"
    cs.parent.mkdir(parents=True, exist_ok=True)
    body = ["[General]", "Name=Expressive", "ColorScheme=Expressive", ""]
    for grp, kv in {**groups, "WM": wm}.items():
        body.append(f"[{grp}]")
        body += [f"{k}={v}" for k, v in kv.items()]
        body.append("")
    cs.write_text("\n".join(body))


def write_env(dark: bool) -> None:
    """Persist the Qt platform-theme choice as a systemd user env, so it applies
    on the next login even outside niri's own `environment {}` block."""
    envd = _CFG / "environment.d" / "95-expressive.conf"
    envd.parent.mkdir(parents=True, exist_ok=True)
    envd.write_text("QT_QPA_PLATFORMTHEME=gtk3\n")


def write_gtk(colors: dict, dark: bool = True) -> None:
    d = colors["dark" if dark else "light"]
    def m(k):
        return d[k]
    pairs = [
        ("accent_color", m("primary")), ("accent_bg_color", m("primary")),
        ("accent_fg_color", m("onPrimary")),
        ("window_bg_color", m("background")), ("window_fg_color", m("onSurface")),
        ("view_bg_color", m("surface")), ("view_fg_color", m("onSurface")),
        ("headerbar_bg_color", m("surfaceContainer")),
        ("headerbar_fg_color", m("onSurface")),
        ("headerbar_border_color", m("outlineVariant")),
        ("headerbar_backdrop_color", m("background")),
        ("headerbar_shade_color", m("shadow")),
        ("card_bg_color", m("surfaceContainerHigh")), ("card_fg_color", m("onSurface")),
        ("popover_bg_color", m("surfaceContainerHigh")),
        ("popover_fg_color", m("onSurface")),
        ("dialog_bg_color", m("surfaceContainerHigh")),
        ("dialog_fg_color", m("onSurface")),
        ("sidebar_bg_color", m("surfaceContainerLow")),
        ("sidebar_fg_color", m("onSurface")),
        ("sidebar_backdrop_color", m("background")),
        ("secondary_sidebar_bg_color", m("surfaceContainerLow")),
        ("overview_bg_color", m("surfaceDim")),
        ("destructive_color", m("error")), ("destructive_bg_color", m("error")),
        ("destructive_fg_color", m("onError")),
        ("success_color", m("tertiary")), ("warning_color", m("secondary")),
        ("error_color", m("error")),
        # classic GTK3 names
        ("theme_bg_color", m("background")), ("theme_fg_color", m("onSurface")),
        ("theme_base_color", m("surface")), ("theme_text_color", m("onSurface")),
        ("theme_selected_bg_color", m("primary")),
        ("theme_selected_fg_color", m("onPrimary")),
        ("insensitive_bg_color", m("surfaceContainer")),
        ("insensitive_fg_color", m("onSurfaceVariant")),
        ("borders", m("outlineVariant")),
    ]
    body = "\n".join(f"@define-color {k} {v};" for k, v in pairs)
    for css in GTK_CSS:
        _managed_block(css, body, BLK_OPEN, BLK_CLOSE)

    pref = "prefer-dark" if dark else "prefer-light"
    theme = "Adwaita-dark" if dark else "Adwaita"
    # libadwaita reads color-scheme; classic GTK3 apps read settings.ini
    try:
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface",
                        "color-scheme", pref],
                       check=False, capture_output=True, timeout=5)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface",
                        "gtk-theme", theme],
                       check=False, capture_output=True, timeout=5)
    except (FileNotFoundError, subprocess.SubprocessError):
        pass
    for ini in (GTK3_SETTINGS, GTK4_SETTINGS):
        _ini_set(ini, "Settings", {
            "gtk-application-prefer-dark-theme": "1" if dark else "0",
            "gtk-theme-name": theme,
        })

    write_qt(colors, dark)
    write_kde(colors, dark)
    write_env(dark)


def apply(colors: dict, label: str, scheme_name: str | None) -> None:
    dark = current_dark()
    write_colors(colors)
    patch_niri(colors)
    write_alacritty(colors, scheme_name, dark)
    write_gtk(colors, dark)
    log(f"themed ({label}, {'dark' if dark else 'light'}) "
        f"-> colors.json + alacritty + gtk + qt")


# --------------------------------------------------------------------------- #
def current_dark() -> bool:
    """The shell's light/dark choice, resolved for the external app configs.
    `appearance.mode` is dark | light | system; `system` follows the desktop
    `color-scheme` preference."""
    mode = "dark"
    try:
        s = json.loads(SETTINGS_JSON.read_text())
        mode = (s.get("appearance") or {}).get("mode", "dark")
    except (OSError, json.JSONDecodeError, AttributeError):
        pass
    if mode == "light":
        return False
    if mode == "dark":
        return True
    try:
        out = subprocess.run(
            ["gsettings", "get", "org.gnome.desktop.interface", "color-scheme"],
            capture_output=True, text=True, timeout=5).stdout
        return "prefer-light" not in out
    except (FileNotFoundError, subprocess.SubprocessError):
        return True


def current_wallpaper() -> str | None:
    try:
        p = WALL_FILE.read_text().strip()
        return p if p and Path(p).is_file() else None
    except OSError:
        return None


def main(argv: list[str]) -> int:
    if argv and argv[0] == "--list":
        for s in all_schemes():
            print(f"{s['name']}\t{s.get('label', s['name'])}")
        return 0

    if argv and argv[0] == "--match":
        img = argv[1] if len(argv) > 1 else current_wallpaper()
        if not img:
            print("dynamic")
            return 0
        print(match_scheme(img))
        return 0

    if argv:
        mode = argv[0]
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            SCHEME_FILE.write_text(mode + "\n")
        except OSError:
            pass
    else:
        try:
            mode = SCHEME_FILE.read_text().strip() or "dynamic"
        except OSError:
            mode = "dynamic"

    img = current_wallpaper()

    if mode.startswith("accent:"):
        seed = mode.split(":", 1)[1].strip() or "#6750a4"
        if not re.fullmatch(r"#?[0-9a-fA-F]{6}", seed):
            log(f"accent: bad colour {seed!r}")
            return 2
        seed = "#" + seed.lstrip("#").lower()
        log(f"accent: manual seed {seed}")
        apply(accent_variants(seed), f"accent {seed}", None)
        return 0

    if mode == "dynamic":
        if not img:
            log("dynamic: no wallpaper set — nothing to generate")
            return 0
        apply(dynamic_variants(img), "dynamic", None)
        return 0

    if mode == "auto":
        if not img:
            name = "gruvbox"
            log("auto: no wallpaper — falling back to gruvbox")
        else:
            name = match_scheme(img)
            log(f"auto: closest scheme to wallpaper -> {name}")
    else:
        name = mode

    apply(load_scheme(name), name, name)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
